{
  "name": "tg-game",
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"pnpm --filter frontend dev\" \"pnpm --filter backend dev\"",
    "build": "pnpm -r build",
    "frontend": "pnpm --filter frontend",
    "backend": "pnpm --filter backend",
     "tunel": "cloudflared tunnel --url http://localhost:5173",
    "lint": "pnpm -r lint",
    "format": "prettier --write -w .",
    "prepare": "husky "
  },
  "dependencies": {
    "prettier": "^3.8.3"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "husky": "^9.1.7"
  }
}
