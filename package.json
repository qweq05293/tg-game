{
  "name": "tg-game",
  "version": "1.0.0",
  "scripts": {
    "db": "docker compose --project-directory packages/backend -f packages/backend/docker-compose.yml up -d",
    "db:down": "docker compose --project-directory packages/backend -f packages/backend/docker-compose.yml down",
    "prisma:generate": "pnpm --filter backend exec prisma generate",
    "prisma:migrate": "pnpm --filter backend exec prisma migrate dev",
    "prisma:studio": "pnpm --filter backend exec prisma studio",
    "prisma": "pnpm prisma:generate && pnpm prisma:migrate",
    "dev": "concurrently \"pnpm --filter frontend dev\" \"pnpm --filter backend dev\"",
    "build": "pnpm -r build",
    "frontend": "pnpm --filter frontend",
    "backend": "pnpm --filter backend",
    "tunel": "tsx scripts/update-env.ts",
    "api": "pnpm -f frontend gen:api",
    "lint": "pnpm -r lint",
    "format": "prettier --write -w .",
    "test": "pnpm -f backend test && pnpm -f backend test:e2e && pnpm -f frontend test ",
    "prepare": "husky "
  },
  "dependencies": {
    "prettier": "^3.8.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "concurrently": "^9.2.1",
    "husky": "^9.1.7",
    "tsx": "^4.22.3"
  }
}
